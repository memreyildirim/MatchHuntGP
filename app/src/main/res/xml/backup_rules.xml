<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup kurallari (API < 31).
  Hassas veriler (FCM token, oturum cache, gizli mesajlar) yedeklenmemelidir.
  Onerilen yaklasim: hicbir sey yedeklenmesin (en guvenli), kullanici tekrar giris yapsin.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="external" path="."/>
    <exclude domain="root" path="."/>
</full-backup-content>
